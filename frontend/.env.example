# Deixe este arquivo sem EXPO_PUBLIC_API_URL ativa para usar a detecção automática:
# - Web local/LAN: usa o host do navegador na porta 8000
# - Expo Go LAN: usa o host do bundle do Expo na porta 8000
# - Codespaces: troca -8081. por -8000. no host
#
# Use uma URL explícita apenas em produção, túnel ou quando a API estiver em outro host.
# Emulador Android com backend local:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
# iOS simulator com backend local:
# EXPO_PUBLIC_API_URL=http://localhost:8000/api
# Device físico (IP local da máquina onde o backend roda):
# EXPO_PUBLIC_API_URL=http://192.168.0.XX:8000/api
# Backend no GitHub Codespace (torne a porta 8000 pública e use a URL do codespace):
#   gh codespace ports visibility 8000:public --codespace <codespace-name>
# EXPO_PUBLIC_API_URL=https://<codespace-name>-8000.app.github.dev/api
